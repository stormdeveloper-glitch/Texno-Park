# ============================================================
# TEXNO PARK POS — Server sozlamalari (.env)
# Ushbu faylni ".env" nomi bilan nusxalab, qiymatlarni to'ldiring.
# MAXFIY KALITLAR faqat shu yerda saqlanadi — brauzerga hech qachon yuborilmaydi.
# ============================================================

PORT=5000
# Productionda FLASK_DEBUG=false bo'lishi SHART (debug=True orqali RCE xavfi bor)
FLASK_DEBUG=false

# --- Ma'lumotlar bazasi (ixtiyoriy, bo'sh bo'lsa SQLite ishlatiladi) ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# MYSQL_URL=mysql://user:password@host:3306/dbname
# DB_PATH=Data/database.db

# --- SAYT DOMENI (yangi domen olinganda FAQAT shu qator o'zgaradi) ---
# Dastur shu qiymatdan CORS manbalarini, Host sarlavhasi tekshiruvini,
# kanonik yo'naltirishni va Turnstile widget domenlarini o'zi aniqlaydi.
#   SITE_DOMAIN=pos.texnopark.uz
SITE_DOMAIN=
# Eski domen / IP manzilni kanonik domenga 301 yo'naltirish (API tegilmaydi)
CANONICAL_REDIRECT=false
# Qo'shimcha ruxsat etilgan hostlar (vergul bilan, ixtiyoriy)
TRUSTED_HOSTS=

# --- Xavfsizlik ---
# HTTPS'ga majburiy yo'naltirish (productionda true qiling; Cloudflare orqasida
# xavfsiz ishlaydi — CF-Visitor/X-Forwarded-Proto to'g'ri o'qiladi)
FORCE_HTTPS=false
# CORS uchun ruxsat etilgan manbalar (vergul bilan). Bo'sh = barchasi.
# SITE_DOMAIN to'ldirilsa, https://SITE_DOMAIN avtomatik qo'shiladi.
ALLOWED_ORIGINS=
# Webhook imzolarini tekshirish uchun umumiy maxfiy token
# (Paynet/Uzum/Paylov callbacklari va /api/payments/mark-paid uchun)
PAYMENT_WEBHOOK_TOKEN=

# --- Xodim autentifikatsiyasi (server tomonidagi RBAC) ---
# Login tokenlarini imzolovchi maxfiy kalit. BO'SH QOLDIRMANG (productionda).
# Bo'sh bo'lsa avtomatik yaratiladi va bazada saqlanadi.
# Kalit almashtirilsa — barcha eski sessiyalar bekor bo'ladi (/api/auth/logout-all).
API_AUTH_SECRET=
# Token amal qilish muddati (soat, 1..72)
API_TOKEN_TTL_HOURS=12
# Bir IP uchun ruxsat etilgan login urinishlari (5 daqiqada, 3..30)
LOGIN_MAX_ATTEMPTS=8
# Birinchi ishga tushirishda xodimlar paroli (standart "123456" o'rniga).
# Parol o'zgartirilmaguncha tizim ogohlantiradi.
STAFF_DEFAULT_PASSWORD=

# --- CLOUDFLARE ---
# Sayt Cloudflare proksisi orqasida ishlaganda true qilinadi. Shundagina
# haqiqiy mijoz IP'si CF-Connecting-IP dan olinadi (rate limit, xavfsizlik
# jurnali va sessiyalar paneli uchun). false bo'lsa CF sarlavhalariga
# ishonilmaydi — aks holda ularni qalbakilashtirish mumkin.
TRUST_CLOUDFLARE=false

# Cloudflare Turnstile (CAPTCHA). Site key ochiq (brauzerga beriladi),
# secret key faqat serverda saqlanadi (siteverify uchun).
# Batafsil: CLOUDFLARE.md
CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRET_KEY=
# true  → login uchun CAPTCHA majburiy (token bo'lmasa 403 captcha_failed).
#         Mobil ilova ham token yuborishi kerak bo'ladi.
# false → brauzer token yuborsa tekshiriladi, yubormasa o'tkaziladi
#         (hodisa jurnalga yoziladi: captcha-missing).
CF_TURNSTILE_ENFORCE=false

# --- Turnstile domenini AVTOMATIK qo'shish ---
# To'ldirilsa, SITE_DOMAIN har ishga tushirishda Turnstile widget domenlariga
# avtomatik qo'shiladi (dashboard'ga kirish shart emas).
CF_ACCOUNT_ID=
CF_TURNSTILE_WIDGET_ID=
CF_AUTO_ADD_DOMAIN=true
# Cloudflare API tokeni: My Profile → API Tokens → Create Token →
# Permission: Account → Turnstile → Edit (boshqa huquq shart emas)
CF_API_TOKEN=

# --- AI YORDAMCHI (admin panel, ixtiyoriy) ---
# AI_API_KEY bo'sh bo'lsa yordamchi tashqi xizmatsiz ishlaydi: bazadagi
# hisoblangan ko'rsatkichlar asosida lokal javob beradi (internet kerak emas).
# Kalit kiritilsa — OpenAI-mos API ishlatiladi (kalit faqat serverda qoladi).
AI_API_KEY=
# OpenAI-mos chat endpoint (OpenRouter, Groq, lokal Ollama va h.k. ham bo'ladi)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
# Tashqi AI javobini kutish vaqti (sekund)
AI_TIMEOUT_SECONDS=25

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=

# --- CLICK (https://merchant.click.uz) ---
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
CLICK_PHONE=

# --- PAYME (https://merchant.paycom.uz) ---
# PAYME_MERCHANT_ID — kassa ID (ochiq), PAYME_KEY — ishlab chiqarish kaliti (maxfiy)
PAYME_MERCHANT_ID=
PAYME_KEY=

# --- PAYNET (https://paynet.uz) ---
PAYNET_MERCHANT_ID=
PAYNET_SERVICE_ID=
PAYNET_KEY=
# To'lov sahifasi shabloni: {order_id}, {amount}, {return_url}, {merchant_id}, {service_id}
PAYNET_CHECKOUT_URL=

# --- UZUM BANK (https://uzumbank.uz) ---
UZUM_MERCHANT_ID=
UZUM_KEY=
UZUM_CHECKOUT_URL=

# --- PAYLOV ---
PAYLOV_MERCHANT_ID=
PAYLOV_KEY=
PAYLOV_CHECKOUT_URL=

# --- Savdo / shartnoma sozlamalari ---
# Standart to'lov tizimi: cash | card | click | payme | paynet | uzum | paylov | credit | transfer
DEFAULT_PAYMENT_PROVIDER=cash
# To'lov buyurtmasi amal qilish muddati (daqiqa)
PAYMENT_ORDER_TTL_MINUTES=15
# Avtomatik shartnomalarda kafolat muddati (oy)
CONTRACT_WARRANTY_MONTHS=12

# ============================================================
# FISKAL CHEK (QR-KODLI CHEK) — O'ZBEKISTON QONUNCHILIGI TALABI
# ============================================================
# Chek FAQAT to'lov to'liq tasdiqlangandan keyin chiqariladi va QR-kod
# (fiskal belgi) faqat OFD/modul javobidan olinadi. Batafsil: FISCAL.md
#
# Provayder: multikassa | soliq | payme | custom | disabled
#   disabled — fiskal modul o'chirilgan (chek chiqmaydi, xavfsiz standart)
FISCAL_PROVIDER=disabled
# Fiskal modul API manzili (to'liq endpoint: MultiKassa / soliq OFD / Payme)
FISCAL_API_URL=
# Savdogar (kassa) identifikatorlari
FISCAL_MERCHANT_ID=
FISCAL_TERMINAL_ID=POS-01
# Maxfiy kalit — FAQAT shu yerda saqlanadi, javobga/logga chiqmaydi
FISCAL_SECRET_KEY=
# Ba'zi OFD'lar alohida API kalit talab qiladi (ixtiyoriy)
FISCAL_API_KEY=
# true  — QR-kodsiz chek chiqarilmaydi (qonun talabi, tavsiya etiladi)
# false — fiskal modul ixtiyoriy (chek "FISKAL EMAS" belgisi bilan chiqadi)
FISCAL_REQUIRED=true
# OFD javobini kutish vaqti (sekund, 5..60)
FISCAL_TIMEOUT_SECONDS=20
# Mahsulotda QQS ko'rsatilmagan bo'lsa ishlatiladigan stavka (%)
FISCAL_DEFAULT_VAT_PERCENT=12
# Chek sarlavhasi (bo'sh bo'lsa Sozlamalar → Kompaniya ma'lumotlari olinadi)
FISCAL_COMPANY_NAME=
FISCAL_COMPANY_TIN=
FISCAL_COMPANY_ADDRESS=
# `custom` provayder uchun javob maydonlari (nuqtali yo'l)
# FISCAL_RESPONSE_URL_FIELD=data.receipt_url
# FISCAL_RESPONSE_SIGN_FIELD=data.fiscal_sign
# FISCAL_RESPONSE_NUMBER_FIELD=data.receipt_id

# --- S3 / obyekt saqlash (ixtiyoriy) ---
# Eslatma: mahsulot rasmlari standart holatda TO'G'RIDAN-TO'G'RI BAZADA saqlanadi
# (brauzerda siqiladi: max 1000px, ≤ 900 KB). S3 faqat qo'shimcha variant.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=
